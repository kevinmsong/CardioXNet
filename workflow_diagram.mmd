    %% CardioXNet live pipeline workflow
    %% Updated to match app/services/pipeline.py

    START([User Input<br/>Seed Genes + Disease Context])

    S1[Stage 1<br/>Input Validation<br/>Validate and normalize gene symbols<br/>Progress: 5%]
    S2[Stage 2<br/>Functional Neighborhood<br/>STRING-based interaction expansion<br/>Progress: 15%]
    S3[Stage 3<br/>Primary Pathway Enrichment<br/>g:Profiler across REAC, KEGG, WP, GO:BP<br/>Progress: 25%]
    S4[Stage 4<br/>Secondary Pathway Discovery<br/>Per-primary expansion with bounded literature expansion<br/>Progress: 40%]
    S5[Stage 5<br/>Pathway Aggregation<br/>Replication-aware aggregation and deduplication<br/>Progress: 55-60%]
    S6[Stage 6<br/>NES Scoring<br/>Rank aggregated pathways by enrichment-based score<br/>Progress: 65-70%]
    S7[Stage 7<br/>Semantic Cardiac Filtering<br/>Cardiac relevance scoring and redundancy reduction<br/>Progress: 72-76%]
    S8[Stage 8<br/>Enhanced Validation<br/>GTEx support, degree-preserving permutations when enabled,<br/>curated plus bounded live Open Targets evidence<br/>Progress: 78-81%]
    S9[Stage 9<br/>Literature Mining and Seed Tracing<br/>PubMed screening plus seed-to-pathway traceability<br/>Progress: 82-84%]
    S10[Stage 10<br/>Final Strict Cardiac Name Filter<br/>Enforce cardiac-name filter and refresh literature on retained pathways<br/>Progress: 77-84%]
    S11[Stage 11<br/>Important Genes<br/>Rank recurrent genes from top pathways with DisGeNET and therapeutic evidence<br/>Progress: 93%]
    S12[Stage 12<br/>Report Generation<br/>JSON, HTML, PDF, CSV-linked outputs<br/>Progress: 97%]
    DONE([Results Ready<br/>Complete: 100%])

    START --> S1 --> S2 --> S3 --> S4 --> S5 --> S6 --> S7 --> S8 --> S9 --> S10 --> S11 --> S12 --> DONE

