flowchart TD
    %% CardioXNet pipeline - verified against app/services/pipeline.py
    %% Every formula and threshold below is the value the code actually uses.
    %% Progress percentages match the _update_progress() calls in Pipeline.run().

    START([/"Seed genes + disease context"/])

    S0["<b>Stage 0 - Input Validation</b> <i>(5%)</i><br/>HGNC symbol normalization<br/>invalid identifiers dropped"]

    S1["<b>Stage 1 - Functional Neighborhood</b> <i>(15%)</i><br/>STRING v12.0 PPI expansion<br/>75 neighbors · combined score ≥ 0.60"]

    S2a["<b>Stage 2a - Primary Enrichment</b> <i>(25%)</i><br/>g:Profiler over REAC · KEGG · WP · GO:BP<br/>FDR ≤ 0.05<br/>screen = 0.40·sig + 0.35·effect + 0.25·specificity"]

    S2b["<b>Stage 2b - Secondary Discovery</b> <i>(40%)</i><br/>top 20 primaries re-expanded<br/>member-gene re-enrichment<br/>optional literature-gene augmentation"]

    S2c["<b>Stage 2c - Aggregation</b> <i>(55%)</i><br/>frequency-based across primaries<br/>Fisher-combined p · Jaccard ≥ 0.70 redundancy filter"]

    S3["<b>Stage 3 - Pathway Prioritization Score</b> <i>(65%)</i><br/>base PPS = db_weight × (<br/>0.30·significance + 0.30·effect size<br/>+ 0.25·specificity + 0.15·upstream support)<br/><i>not a GSEA NES</i>"]

    S35["<b>Stage 3.5 - Semantic Cardiac Filter</b> <i>(72%)</i><br/>curated cardiovascular term scoring<br/>3-tier disease-context thresholds"]

    S4["<b>Stage 4 - Biological Validation</b> <i>(78%)</i><br/>GTEx v8 cardiac expression (Heart LV + Atrial Appendage)<br/>1000-permutation size-matched null vs HGNC genome<br/>Benjamini–Hochberg FDR · DrugBank + ChEMBL druggability"]

    S6["<b>Stage 6 - Literature Mining</b> <i>(85%)</i><br/>PubMed query = genes <b>AND</b> pathway concept <b>AND</b> disease<br/>esearch <i>Count</i> gives the true corpus size<br/>seed-gene → pathway traceability"]

    S6c["<b>Stage 6c - Final Cardiac Filter</b> <i>(88%)</i><br/>cardiac/disease term in pathway name<br/><b>or</b> semantic rescue (relevance + upstream support + significance)"]

    S7["<b>Stage 7 - Network Topology</b> <i>(91%)</i><br/>hub score = 0.35·betweenness + 0.25·PageRank<br/>+ 0.20·degree + 0.15·eigenvector + 0.05·closeness"]

    S8["<b>Stage 8 - Novelty &amp; Discovery</b> <i>(96%)</i><br/>PPS = base PPS × (1 + semantic relevance)<br/>saturation = log₁₀(hits+1) / log₁₀(1001)<br/>composite novelty = (2·literature novelty + gene novelty) / 3<br/><b>Discovery = PPS × composite novelty</b>"]

    S9["<b>Stage 9 - Report Generation</b> <i>(100%)</i><br/>JSON · PDF · Markdown · CSV<br/>ranked hypotheses · hub genes · target candidates"]

    DONE([/"Ranked discoveries + evidence"/])

    START --> S0 --> S1 --> S2a --> S2b --> S2c --> S3 --> S35 --> S4 --> S6 --> S6c --> S7 --> S8 --> S9 --> DONE

    %% External data sources
    DB1[("STRING v12.0<br/>protein interactions")]
    DB2[("g:Profiler<br/>REAC · KEGG · WP · GO:BP")]
    DB3[("GTEx v8<br/>cardiac expression")]
    DB4[("PubMed / NCBI E-utilities<br/>corpus sizes + abstracts")]
    DB5[("DrugBank v5.1.10 · ChEMBL<br/>Open Targets")]
    DB6[("HGNC protein-coding genome<br/>permutation background")]

    DB1 -.->|"PPI network"| S1
    DB2 -.->|"enrichment"| S2a
    DB2 -.->|"re-enrichment"| S2b
    DB3 -.->|"expression validation"| S4
    DB6 -.->|"null background"| S4
    DB5 -.->|"druggability"| S4
    DB4 -.->|"corpus size + abstracts"| S6
    DB1 -.->|"edges for centrality"| S7

    classDef input    fill:#1E6B52,stroke:#0F3D2F,stroke-width:3px,color:#fff,font-weight:bold
    classDef stage    fill:#2563EB,stroke:#1D4ED8,stroke-width:2px,color:#fff
    classDef filter   fill:#7C3AED,stroke:#5B21B6,stroke-width:2px,color:#fff
    classDef validate fill:#0891B2,stroke:#0E7490,stroke-width:2px,color:#fff
    classDef score    fill:#059669,stroke:#047857,stroke-width:2px,color:#fff
    classDef output   fill:#D97706,stroke:#B45309,stroke-width:2px,color:#fff
    classDef done     fill:#1E3A5F,stroke:#0F1E30,stroke-width:3px,color:#fff,font-weight:bold
    classDef db       fill:#475569,stroke:#334155,stroke-width:2px,color:#fff

    class START input
    class DONE done
    class S0,S1,S2a,S2b,S2c stage
    class S35,S6c filter
    class S4,S7 validate
    class S3,S8 score
    class S9 output
    class DB1,DB2,DB3,DB4,DB5,DB6 db
