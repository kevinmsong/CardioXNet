flowchart TD
    %% CardioXNet NETS Pipeline — reflects app/services/pipeline.py

    START([/"User Input\nSeed Genes + Disease Context"\])

    S0["**Stage 0 — Input Validation** *(5%)*\nNormalize gene symbols via HGNC\nFilter invalid identifiers"]

    S1["**Stage 1 — Functional Neighborhood** *(15%)*\nSTRING PPI expansion\n75 neighbors · confidence ≥ 0.60"]

    S2a["**Stage 2a — Primary Pathway Enrichment** *(25%)*\ng:Profiler across REAC, KEGG, WP, GO:BP\nFDR-adjusted p ≤ 0.05 · fold-enrichment ≥ 2.0"]

    S2b["**Stage 2b — Secondary Pathway Discovery** *(40%)*\nPer-primary neighbor re-expansion\nPubMed context-guided enrichment"]

    S2c["**Stage 2c — Pathway Aggregation** *(55%)*\nFrequency-based aggregation across primaries\nJaccard ≥ 0.85 redundancy filtering"]

    S3["**Stage 3 — NES Scoring** *(65%)*\nNES = –log₁₀(p_adj) × √gene_count × db_weight\nReactome/KEGG 1.5× · WikiPathways 1.2× · GO:BP 1.0×"]

    S35["**Stage 3.5 — Semantic Cardiac Filtering** *(75%)*\n700+ curated cardiovascular terms\n3-tier disease thresholds · strict name filter"]

    S4["**Stage 4 — Enhanced Validation** *(83%)*\nGTEx v8 cardiac expression ratio ≥ 0.50\n25 degree-preserving permutations (empirical p-values)\nDruggability: curated DrugBank + live ChEMBL API"]

    S4b["**Stage 4b — Literature Mining** *(88%)*\nPubMed abstract screening (20 per gene)\nSeed-gene-to-pathway traceability"]

    S4c["**Stage 4c — Network Topology** *(93%)*\nPageRank · Betweenness · Closeness centrality\nHub gene identification from top pathways"]

    S5["**Stage 5 — Important Genes** *(95%)*\nImportance = Frequency^1.2 × Avg NES × (1 + Cardiac Score)\nDruggability tier annotation"]

    S6["**Stage 6 — Report Generation** *(100%)*\nJSON + PDF output\nRanked hypotheses · Hub genes · Top therapeutic targets"]

    DONE([/"Results Ready\nRanked Pathways · Therapeutic Targets · Export"\])

    START --> S0 --> S1 --> S2a --> S2b --> S2c --> S3 --> S35 --> S4 --> S4b --> S4c --> S5 --> S6 --> DONE

    %% External data sources
    DB1[("STRING v11.5\nProtein interactions")]
    DB2[("g:Profiler\nREAC · KEGG · WP · GO:BP")]
    DB3[("GTEx v8\nCardiac tissue expression")]
    DB4[("PubMed / NCBI\nLiterature screening")]
    DB5[("Curated cardiac DB\nOMIM · ClinGen · DrugBank")]

    DB1 -.->|"PPI network"| S1
    DB2 -.->|"Enrichment"| S2a
    DB2 -.->|"Re-enrichment"| S2b
    DB3 -.->|"Expression validation"| S4
    DB4 -.->|"Disease context"| S2b
    DB4 -.->|"Abstract mining"| S4b
    DB5 -.->|"Druggability + permutation context"| S4
    DB5 -.->|"Gene-disease scores"| S5

